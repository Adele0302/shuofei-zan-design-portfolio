# Copy to .env, manually load with your shell or Docker Compose.
# Use generated, unique keys at least 16 chars long. Do not commit real credentials.
APP_DB_PATH=./local_data/knowledge_v2.sqlite3
APP_API_KEYS='{"REPLACE_WITH_LONG_RANDOM_EDITOR_KEY":{"workspace":"demo","role":"editor","name":"Demo Editor"},"REPLACE_WITH_ANOTHER_RANDOM_REVIEWER_KEY":{"workspace":"demo","role":"reviewer","name":"Demo Reviewer"}}'
# auto = official MCP SDK when installed, otherwise explicitly labeled fallback
MCP_PROTOCOL=auto
# Off by default: reproducible Chinese-English lexical baseline.
EMBEDDING_BACKEND=off
# To enable: pip install -r requirements-semantic.txt; set backend=sentence-transformers
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DENSE_MIN_SIMILARITY=0.35
# Alternative paid embedding and grounded-response providers:
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODEL=gpt-4.1-mini
